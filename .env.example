# Copiar como .env para dev local, y cargar las mismas variables en Vercel
# (Settings → Environment Variables). Sin las dos VITE_, la app corre en modo
# local (semilla + localStorage), sin Supabase.

VITE_SUPABASE_URL=            # https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=       # anon/public key (Settings → API)
SUPABASE_SERVICE_ROLE_KEY=    # solo en funciones serverless, nunca en el cliente
ADMIN_KEY=                    # clave del editor (la que se pide al entrar a /editor)
